# Copy to .env and fill in the values. Never commit the real .env.

APP_NAME=Small Business Inventory API
APP_ENV=development

# Generate a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-to-a-long-random-string

# Local Postgres
DATABASE_URL=postgresql+psycopg://app_user:yourpassword@localhost:5432/small_business_db
TEST_DATABASE_URL=postgresql+psycopg://app_user:yourpassword@localhost:5432/small_business_test_db

REDIS_URL=redis://localhost:6379/0
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
